# Local MySQL configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=civicai
DB_SSL=false

# Replace with a long, random secret. Never use this example value.
JWT_SECRET=replace_with_a_long_random_secret

# Local Flask AI service
AI_SERVICE_URL=http://127.0.0.1:5001
PORT=5000

# Gmail SMTP for registration OTPs. Use an App Password, not your normal password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
